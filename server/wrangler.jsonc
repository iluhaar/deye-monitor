{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deye-monitor-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "GRID_EVENT_STREAMS", "class_name": "GridEventStream" }]
  },
  "migrations": [{ "tag": "grid-event-stream-v1", "new_sqlite_classes": ["GridEventStream"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deye-monitor-local",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_READ_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "API_AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "FRESHNESS_THRESHOLD_SECONDS": "60"
  },
  "env": {
    "production": {
      "durable_objects": {
        "bindings": [{ "name": "GRID_EVENT_STREAMS", "class_name": "GridEventStream" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "deye-monitor-production",
          "database_id": "d7c16581-ffbc-43ec-b048-21c3af81fdb8",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "API_READ_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "API_AUTH_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "vars": {
        "FRESHNESS_THRESHOLD_SECONDS": "60"
      }
    }
  }
}
